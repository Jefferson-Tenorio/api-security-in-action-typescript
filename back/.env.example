# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Database (user connection)
DATABASE_URL=postgres://admin:admin@localhost:5432/board

# Database (admin connection)
DATABASE_URL_ADMIN=postgres://admin:admin@localhost:5432/board

# Local Postgres (docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=board

# JWT (optional — defaults to 15min and back/certs/)
JWT_EXPIRES_IN_MS=900000
# JWT_ISSUER=natter-api
# JWT_AUDIENCE=natter-web
# JWT_PRIVATE_KEY_PATH=/path/to/private.pem
# JWT_PUBLIC_KEY_PATH=/path/to/public.pem

# HTTP (optional)
# REQUEST_TIMEOUT_MS=30000